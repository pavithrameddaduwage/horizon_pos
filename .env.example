# ==============================================================================
# HORIZON POS CENTRALIZED PORTAL - ENVIRONMENT TEMPLATE
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data Warehouse / PostgreSQL Database Connection (DW Config)
DW_HOST=localhost
DW_PORT=5432
DW_USER=postgres
DW_PASSWORD=your_password
DW_NAME=report_portal_db

DATABASE_URL="postgresql://postgres:your_password@localhost:5432/report_portal_db?schema=public"
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/report_portal_db?schema=public"

# Auth Secrets & Inter-Service Token
NEXTAUTH_SECRET="your-generated-jwt-secret-here"
NEXTAUTH_URL="http://localhost:3000"
SERVICE_API_KEY="horizon_internal_pos_secret_key"

# 4 Decoupled Backend Microservices URLs (Leave empty or unset for embedded local microservice mode)
HOBBY_LOBBY_SERVICE_URL=""
FIVE_BELOW_SERVICE_URL=""
KOHLS_SERVICE_URL=""
MSI_SERVICE_URL=""

# Scoped Retailer Ingestion Keys
HOBBY_LOBBY_API_KEY="pos_live_hl_xxxx"
FIVE_BELOW_API_KEY="pos_live_fb_xxxx"
KOHLS_API_KEY="pos_live_kh_xxxx"
MSI_API_KEY="pos_live_msi_xxxx"

# Pipeline Configs
MAX_FILE_SIZE_MB=50
ENABLE_STREAMING_VALIDATION=true
AUTO_DETECT_REPORT_FAMILY=true
