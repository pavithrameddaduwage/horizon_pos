# ==============================================================================
# HORIZON POS CENTRALIZED PORTAL - ENVIRONMENT TEMPLATE
# ==============================================================================

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://username:password@localhost:5432/horizon_pos_db?schema=public"
DIRECT_URL="postgresql://username:password@localhost:5432/horizon_pos_db?schema=public"

# Auth Secrets
NEXTAUTH_SECRET="your-generated-jwt-secret-here"
NEXTAUTH_URL="http://localhost:3000"
API_GATEWAY_SECRET="your-gateway-secret-here"

# Scoped Retailer API Keys
HOBBY_LOBBY_API_KEY="pos_live_hl_xxxx"
FIVE_BELOW_API_KEY="pos_live_fb_xxxx"
KOHLS_API_KEY="pos_live_kh_xxxx"
MIS_API_KEY="pos_live_mis_xxxx"

# Pipeline Configs
MAX_FILE_SIZE_MB=50
ENABLE_STREAMING_VALIDATION=true
AUTO_DETECT_REPORT_FAMILY=true
